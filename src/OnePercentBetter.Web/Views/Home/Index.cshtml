@{
    ViewData["Title"] = "Inicio";
}

<section class="grid min-h-screen place-items-center px-4 py-10">
    <div class="mx-auto grid w-full max-w-6xl gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-sm font-semibold text-emerald-200">
                <i data-lucide="sparkles" class="h-4 w-4"></i>
                Mais 1% hoje
            </div>
            <h1 class="max-w-3xl text-5xl font-black tracking-tight text-white sm:text-6xl lg:text-7xl">
                1% Better
            </h1>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
                Seu painel pessoal para transformar identidades em objetivos, objetivos em habitos e habitos em progresso visivel.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a class="btn-primary" asp-controller="Account" asp-action="Register">
                    <i data-lucide="arrow-right" class="h-4 w-4"></i>
                    Comecar
                </a>
                <a class="btn-secondary" asp-controller="Account" asp-action="Login">Entrar</a>
            </div>
        </div>

        <div class="app-card p-5 sm:p-6">
            <div class="grid gap-4">
                <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
                    <div class="text-sm text-slate-400">Hoje voce esta</div>
                    <div class="mt-2 text-5xl font-black text-emerald-300">37%</div>
                    <div class="mt-1 text-sm text-slate-400">mais perto do sistema que quer construir</div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
                        <div class="text-sm text-slate-400">Sequencia</div>
                        <div class="mt-2 text-3xl font-bold text-white">6 dias</div>
                    </div>
                    <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
                        <div class="text-sm text-slate-400">Habitos ativos</div>
                        <div class="mt-2 text-3xl font-bold text-white">4</div>
                    </div>
                </div>
                <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/10 p-5">
                    <div class="text-sm font-semibold text-emerald-200">Identidade em construcao</div>
                    <div class="mt-2 text-xl font-bold text-white">Desenvolvedor .NET consistente</div>
                </div>
            </div>
        </div>
    </div>
</section>
