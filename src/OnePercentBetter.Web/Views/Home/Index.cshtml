@{
    ViewData["Title"] = "Início";

    var weeklyBars = new[] { 36, 52, 48, 63, 57, 72, 68 };
    var consistencyHeat = new[] { 3, 2, 1, 0, 2, 3, 1, 2, 3, 2, 1, 2, 3, 3, 0, 1, 2, 3, 2, 2, 1, 3, 2, 1, 0, 2, 3, 2 };

    var steps = new[]
    {
        new
        {
            Icon = "user-round-check",
            Title = "Defina quem você quer se tornar",
            Description = "Comece por identidades, não apenas por metas. O sistema ajuda você a construir a pessoa que deseja ser."
        },
        new
        {
            Icon = "target",
            Title = "Transforme objetivos em hábitos",
            Description = "Quebre grandes objetivos em pequenas ações diárias, claras e fáceis de executar."
        },
        new
        {
            Icon = "calendar-check",
            Title = "Registre seu progresso diário",
            Description = "Marque hábitos, faça check-ins e registre anotações sobre sua evolução."
        },
        new
        {
            Icon = "line-chart",
            Title = "Ajuste seu sistema com dados",
            Description = "Use dashboards, calendário e revisões para entender o que funciona e melhorar continuamente."
        }
    };

    var features = new[]
    {
        new { Icon = "user-round-check", Title = "Identidades", Description = "Defina a versão de você que quer construir." },
        new { Icon = "target", Title = "Objetivos", Description = "Transforme direção em foco real." },
        new { Icon = "repeat-2", Title = "Hábitos bons", Description = "Ações pequenas que geram progresso acumulado." },
        new { Icon = "ban", Title = "Hábitos ruins", Description = "Mapeie padrões e reduza comportamentos que travam evolução." },
        new { Icon = "calendar-check", Title = "Check-in diário", Description = "Registre humor, energia e produtividade." },
        new { Icon = "notebook-pen", Title = "Anotações", Description = "Capture aprendizados, ajustes e insights do dia." },
        new { Icon = "layout-dashboard", Title = "Dashboard", Description = "Veja métricas claras de constância e avanço." },
        new { Icon = "calendar-days", Title = "Calendário", Description = "Visualize consistência em uma linha do tempo." },
        new { Icon = "refresh-cw", Title = "Revisões", Description = "Refine seu sistema semanal e mensalmente." }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}


<div class="lp-page">
    <header class="lp-topbar">
        <div class="lp-topbar-inner">
            <a class="lp-brand" asp-controller="Home" asp-action="Index">
                <img src="~/1PercentBetterLogo.png"
                     asp-append-version="true"
                     alt="Logo 1% Better"
                     class="lp-brand-logo" />
                <span class="lp-brand-text">1% Better</span>
            </a>

            <nav class="lp-nav-links" aria-label="Links principais">
                <a href="#como-funciona">Como funciona</a>
                <a href="#recursos">Recursos</a>
                <a asp-controller="Account" asp-action="Login">Entrar</a>
            </nav>

            <div class="lp-topbar-actions">
                <a class="btn-secondary" asp-controller="Account" asp-action="Login">Entrar</a>
                <a class="btn-primary" asp-controller="Account" asp-action="Register">Criar meu sistema</a>
            </div>
        </div>

        <nav class="lp-nav-mobile" aria-label="Links principais mobile">
            <a href="#como-funciona">Como funciona</a>
            <a href="#recursos">Recursos</a>
            <a asp-controller="Account" asp-action="Login">Entrar</a>
        </nav>
    </header>

    <main class="lp-main">
        <section class="lp-hero" aria-labelledby="hero-title">
            <div class="lp-hero-watermark" aria-hidden="true">
                <img src="~/1PercentBetterLogo.png" asp-append-version="true" alt="" />
            </div>

            <div class="lp-hero-grid">
                <div class="lp-hero-copy">

                    <div id="logo_frase">
                        <div class="lp-logo-core" aria-hidden="true">
                            <span class="lp-logo-glow"></span>
                            <img src="~/1PercentBetterLogo.png" asp-append-version="true" alt="" class="lp-logo-core-image" />
                        </div>

                        <div class="lp-badge">
                            <i data-lucide="sparkles" class="h-4 w-4"></i>
                            Seu sistema pessoal de evolução
                        </div>
                    </div>

                    

                    <h1 id="hero-title">Evolua 1% todos os dias.</h1>
                    <p>
                        Crie identidades, transforme objetivos em hábitos e acompanhe sua evolução com dashboards,
                        check-ins, anotações e sistemas visuais.
                    </p>

                    <div class="lp-hero-actions">
                        <a class="btn-primary" asp-controller="Account" asp-action="Register">Criar meu sistema</a>
                        <a class="btn-secondary" asp-controller="Account" asp-action="Login">Já tenho conta</a>
                    </div>

                    <p class="lp-hero-note">
                        Mais que um app de hábitos: uma central de controle pessoal para transformar objetivos em sistemas diários.
                    </p>
                </div>

                <aside class="lp-preview app-card" aria-label="Prévia do sistema">
                    <div class="lp-preview-head">
                        <div>
                            <p class="lp-preview-kicker">Preview do sistema</p>
                            <h2>Painel 1% Better</h2>
                        </div>
                        <span class="status-pill status-pill-info">Tempo real</span>
                    </div>

                    <div class="lp-kpi-strong">
                        <div class="lp-kpi-label">Hoje você está</div>
                        <div class="lp-kpi-value">37%</div>
                        <div class="lp-kpi-subtitle">mais perto do seu sistema</div>
                    </div>

                    <div class="lp-kpi-grid">
                        <div class="lp-kpi-card">
                            <div class="lp-kpi-card-label">Sequência</div>
                            <div class="lp-kpi-card-value">6 dias</div>
                        </div>
                        <div class="lp-kpi-card">
                            <div class="lp-kpi-card-label">Hábitos ativos</div>
                            <div class="lp-kpi-card-value">4/5 hábitos</div>
                        </div>
                    </div>

                    <div class="lp-identity-card">
                        <div class="lp-identity-label">Identidade em construção</div>
                        <div class="lp-identity-value">Desenvolvedor .NET consistente</div>
                    </div>

                    <div class="lp-metrics-grid">
                        <div class="lp-metric-card">
                            <div class="lp-metric-head">
                                <span>Evolução semanal</span>
                                <i data-lucide="line-chart" class="h-4 w-4"></i>
                            </div>
                            <div class="lp-bars" aria-hidden="true">
                                @foreach (var bar in weeklyBars)
                                {
                                    <span class="lp-bar" style="--bar:@bar%"></span>
                                }
                            </div>
                        </div>

                        <div class="lp-metric-card">
                            <div class="lp-metric-head">
                                <span>Consistência</span>
                                <i data-lucide="calendar-days" class="h-4 w-4"></i>
                            </div>
                            <div class="lp-heatmap" aria-hidden="true">
                                @foreach (var level in consistencyHeat)
                                {
                                    <span class="lp-heat lp-heat-@level"></span>
                                }
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        <section id="como-funciona" class="lp-section">
            <div class="lp-section-head">
                <p class="lp-section-kicker">Como funciona</p>
                <h2>Como o 1% Better funciona</h2>
            </div>

            <div class="lp-grid lp-grid-4">
                @foreach (var step in steps)
                {
                    <article class="lp-info-card">
                        <div class="lp-info-icon">
                            <i data-lucide="@step.Icon" class="h-5 w-5"></i>
                        </div>
                        <h3>@step.Title</h3>
                        <p>@step.Description</p>
                    </article>
                }
            </div>
        </section>

        <section id="recursos" class="lp-section">
            <div class="lp-section-head">
                <p class="lp-section-kicker">Recursos principais</p>
                <h2>Tudo que você precisa para evoluir com clareza</h2>
            </div>

            <div class="lp-grid lp-grid-3">
                @foreach (var feature in features)
                {
                    <article class="lp-feature-card">
                        <div class="lp-feature-icon">
                            <i data-lucide="@feature.Icon" class="h-5 w-5"></i>
                        </div>
                        <h3>@feature.Title</h3>
                        <p>@feature.Description</p>
                    </article>
                }
            </div>
        </section>

        <section class="lp-final-cta app-card">
            <p class="lp-section-kicker">Pronto para começar</p>
            <h2>Comece construindo seu primeiro sistema.</h2>
            <p>Pequenos hábitos, quando repetidos com consistência, viram progresso visível.</p>
            <a class="btn-primary" asp-controller="Account" asp-action="Register">Criar meu sistema</a>
        </section>
    </main>
</div>
