@{
    var title = ViewData["Title"] as string ?? "1% Better";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - 1% Better</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        surface: '#0b1120',
                        panel: '#111827',
                        line: 'rgba(148, 163, 184, 0.18)'
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,rgba(34,197,94,0.16),transparent_28rem),radial-gradient(circle_at_top_right,rgba(56,189,248,0.14),transparent_26rem)]"></div>

    @if (isAuthenticated)
    {
        <div class="min-h-screen lg:grid lg:grid-cols-[17rem_1fr]">
            <aside class="hidden border-r border-white/10 bg-slate-950/80 px-5 py-6 backdrop-blur lg:block">
                <a class="flex items-center gap-3" asp-controller="Dashboard" asp-action="Index">
                    <span class="grid h-10 w-10 place-items-center rounded-2xl bg-emerald-400 text-sm font-black text-slate-950">1%</span>
                    <span>
                        <span class="block text-sm font-semibold tracking-wide text-white">1% Better</span>
                        <span class="block text-xs text-slate-400">Centro de evolucao</span>
                    </span>
                </a>

                <nav class="mt-8 space-y-1">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i data-lucide="layout-dashboard"></i> Dashboard</a>
                    <a class="nav-link" asp-controller="Habits" asp-action="Index"><i data-lucide="repeat-2"></i> Habitos</a>
                    <a class="nav-link" asp-controller="CheckIns" asp-action="Today"><i data-lucide="calendar-check"></i> Check-in</a>
                    <a class="nav-link" asp-controller="Identities" asp-action="Index"><i data-lucide="user-round-check"></i> Identidades</a>
                    <a class="nav-link" asp-controller="Goals" asp-action="Index"><i data-lucide="target"></i> Objetivos</a>
                    <a class="nav-link" asp-controller="Calendar" asp-action="Index"><i data-lucide="calendar-days"></i> Calendario</a>
                    <a class="nav-link" asp-controller="Notes" asp-action="Index"><i data-lucide="notebook-pen"></i> Anotacoes</a>
                </nav>
            </aside>

            <div class="min-w-0">
                <header class="sticky top-0 z-20 border-b border-white/10 bg-slate-950/82 px-4 py-3 backdrop-blur lg:px-8">
                    <div class="flex items-center justify-between gap-4">
                        <a class="flex items-center gap-2 lg:hidden" asp-controller="Dashboard" asp-action="Index">
                            <span class="grid h-9 w-9 place-items-center rounded-xl bg-emerald-400 text-xs font-black text-slate-950">1%</span>
                            <span class="font-semibold">1% Better</span>
                        </a>
                        <div class="hidden text-sm text-slate-400 lg:block">Pequeno hoje. Forte no acumulado.</div>
                        <partial name="_LoginPartial" />
                    </div>
                    <nav class="mt-3 flex gap-2 overflow-x-auto pb-1 lg:hidden">
                        <a class="mobile-nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        <a class="mobile-nav-link" asp-controller="Habits" asp-action="Index">Habitos</a>
                        <a class="mobile-nav-link" asp-controller="CheckIns" asp-action="Today">Check-in</a>
                        <a class="mobile-nav-link" asp-controller="Goals" asp-action="Index">Objetivos</a>
                    </nav>
                </header>

                <main class="mx-auto w-full max-w-7xl px-4 py-6 lg:px-8">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        window.__flashMessages = [];
        @if (TempData["Success"] is string success)
        {
            <text>window.__flashMessages.push({ type: 'success', message: @Json.Serialize(success) });</text>
        }
        @if (TempData["Warning"] is string warning)
        {
            <text>window.__flashMessages.push({ type: 'warning', message: @Json.Serialize(warning) });</text>
        }
        @if (TempData["Info"] is string info)
        {
            <text>window.__flashMessages.push({ type: 'info', message: @Json.Serialize(info) });</text>
        }
    </script>
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
