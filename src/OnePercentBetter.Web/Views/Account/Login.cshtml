@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<section class="grid min-h-screen place-items-center px-4 py-10">
    <div class="w-full max-w-md">
        <a class="mb-8 flex items-center justify-center gap-3" asp-controller="Home" asp-action="Index">
            <img src="~/1PercentBetterLogo.png"
                 asp-append-version="true"
                 alt="1% Better"
                 class="h-11 w-11 rounded-2xl bg-slate-900/40 object-contain p-1" />
            <span class="text-xl font-black text-white">1% Better</span>
        </a>

        <div class="app-card p-6">
            <h1 class="text-2xl font-black text-white">Entrar</h1>
            <p class="mt-2 text-sm text-slate-400">Volte para o seu centro de controle pessoal.</p>

            <form class="mt-6 space-y-4" asp-action="Login" method="post">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3"></div>

                <div>
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" class="form-input" autocomplete="username" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div>
                    <label asp-for="Password" class="form-label">Senha</label>
                    <input asp-for="Password" class="form-input" autocomplete="current-password" />
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="text-right">
                    <a class="text-sm font-semibold text-sky-300 hover:text-sky-200" asp-action="ForgotPassword">Esqueci minha senha</a>
                </div>

                <label class="flex items-center gap-2 text-sm text-slate-300">
                    <input asp-for="RememberMe" class="h-4 w-4 rounded border-white/20 bg-slate-900 text-emerald-400" />
                    Manter conectado
                </label>

                <button type="submit" class="btn-primary w-full">Entrar</button>
            </form>

            @if (Model.ShowResendConfirmationHint)
            {
                <div class="mt-4 rounded-xl border border-amber-300/30 bg-amber-300/10 p-3 text-sm text-amber-100">
                    <p>Sua conta ainda não foi ativada. Verifique seu e-mail.</p>
                    <a class="mt-2 inline-flex font-semibold text-amber-50 underline"
                       asp-action="ResendConfirmationEmail"
                       asp-route-email="@Model.PendingConfirmationEmail">
                        Reenviar e-mail de ativação
                    </a>
                </div>
            }

            <p class="mt-6 text-center text-sm text-slate-400">
                Ainda não tem conta?
                <a class="font-semibold text-emerald-300 hover:text-emerald-200" asp-action="Register">Criar agora</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
