@model AccountActionResultViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="grid min-h-screen place-items-center px-4 py-10">
    <div class="w-full max-w-xl app-card p-6 sm:p-8 text-center">
        @if (Model.IsSuccess)
        {
            <span class="mx-auto inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-emerald-300/30 bg-emerald-300/10 text-emerald-300">
                <i data-lucide="check" class="h-6 w-6"></i>
            </span>
        }
        else
        {
            <span class="mx-auto inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-rose-300/30 bg-rose-300/10 text-rose-300">
                <i data-lucide="triangle-alert" class="h-6 w-6"></i>
            </span>
        }

        <h1 class="mt-4 text-2xl font-black text-white">@Model.Title</h1>
        <p class="mt-3 text-sm text-slate-300">@Model.Message</p>

        <div class="mt-6 flex flex-wrap justify-center gap-3">
            @if (!string.IsNullOrWhiteSpace(Model.PrimaryActionLabel) && !string.IsNullOrWhiteSpace(Model.PrimaryActionUrl))
            {
                <a class="btn-primary" href="@Model.PrimaryActionUrl">@Model.PrimaryActionLabel</a>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SecondaryActionLabel) && !string.IsNullOrWhiteSpace(Model.SecondaryActionUrl))
            {
                <a class="btn-secondary" href="@Model.SecondaryActionUrl">@Model.SecondaryActionLabel</a>
            }
        </div>
    </div>
</section>
