@{
    ViewData["Title"] = "E-mail enviado";
}

<section class="grid min-h-screen place-items-center px-4 py-10">
    <div class="w-full max-w-xl app-card p-6 sm:p-8 text-center">
        <span class="mx-auto inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-sky-300/30 bg-sky-300/10 text-sky-300">
            <i data-lucide="mail" class="h-6 w-6"></i>
        </span>
        <h1 class="mt-4 text-2xl font-black text-white">Verifique seu e-mail</h1>
        <p class="mt-3 text-sm text-slate-300">Se este e-mail estiver cadastrado, enviaremos instruções para recuperação de senha.</p>
        <p class="mt-1 text-sm text-slate-400">Por segurança, não informamos se o endereço existe na base.</p>

        <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a class="btn-primary" asp-action="Login">Ir para login</a>
            <a class="btn-secondary" asp-action="ForgotPassword">Tentar outro e-mail</a>
        </div>
    </div>
</section>
