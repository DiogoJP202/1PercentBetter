@model ResendConfirmationEmailViewModel
@{
    ViewData["Title"] = "Confirmação de conta";
}

<section class="grid min-h-screen place-items-center px-4 py-10">
    <div class="w-full max-w-xl">
        <div class="app-card p-6 sm:p-8">
            <div class="flex items-start gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-emerald-300/30 bg-emerald-300/10 text-emerald-300">
                    <i data-lucide="mail-check" class="h-5 w-5"></i>
                </span>
                <div>
                    <h1 class="text-2xl font-black text-white">Conta criada</h1>
                    <p class="mt-2 text-sm text-slate-300">Enviamos um link de ativação para <span class="font-semibold text-emerald-200">@Model.Email</span>.</p>
                    <p class="mt-1 text-sm text-slate-400">Abra seu e-mail e clique no link para liberar o login.</p>
                </div>
            </div>

            <div class="mt-6 rounded-xl border border-white/10 bg-white/[0.03] p-4">
                <p class="text-sm text-slate-300">Não recebeu o e-mail?</p>
                <form asp-action="ResendConfirmationEmail" method="post" class="mt-3 grid gap-3 sm:grid-cols-[1fr_auto]">
                    <div>
                        <label asp-for="Email" class="form-label">E-mail</label>
                        <input asp-for="Email" class="form-input" autocomplete="email" />
                        <span asp-validation-for="Email"></span>
                    </div>
                    <button type="submit" class="btn-secondary sm:self-end">Reenviar ativação</button>
                </form>
            </div>

            <div class="mt-6 flex flex-wrap gap-3">
                <a class="btn-primary" asp-action="Login" asp-route-email="@Model.Email">Ir para login</a>
                <a class="btn-secondary" asp-controller="Home" asp-action="Index">Voltar ao início</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
