@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Redefinir senha";
}

<section class="grid min-h-screen place-items-center px-4 py-10">
    <div class="w-full max-w-md app-card p-6">
        <h1 class="text-2xl font-black text-white">Redefinir senha</h1>
        <p class="mt-2 text-sm text-slate-400">Defina sua nova senha para continuar usando o 1% Better.</p>

        <form asp-action="ResetPassword" method="post" class="mt-6 space-y-4">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3"></div>

            <div>
                <label asp-for="Password" class="form-label">Nova senha</label>
                <input asp-for="Password" class="form-input" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="form-label">Confirmar nova senha</label>
                <input asp-for="ConfirmPassword" class="form-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn-primary w-full">Salvar nova senha</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
