@model RegisterViewModel
@{
    ViewData["Title"] = "Criar conta";
}

<section class="grid min-h-screen place-items-center px-4 py-10">
    <div class="w-full max-w-md">
        <a class="mb-8 flex items-center justify-center gap-3" asp-controller="Home" asp-action="Index">
            <img src="~/1PercentBetterLogo.png"
                 asp-append-version="true"
                 alt="1% Better"
                 class="h-11 w-11 rounded-2xl bg-slate-900/40 object-contain p-1" />
            <span class="text-xl font-black text-white">1% Better</span>
        </a>

        <div class="app-card p-6">
            <h1 class="text-2xl font-black text-white">Criar conta</h1>
            <p class="mt-2 text-sm text-slate-400">Comece seu sistema pessoal de evolução. Após o cadastro, enviaremos um e-mail para ativação.</p>

            <form class="mt-6 space-y-4" asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3"></div>

                <div>
                    <label asp-for="DisplayName" class="form-label">Nome de exibição</label>
                    <input asp-for="DisplayName" class="form-input" autocomplete="name" />
                    <span asp-validation-for="DisplayName"></span>
                </div>

                <div>
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" class="form-input" autocomplete="email" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div>
                    <label asp-for="Password" class="form-label">Senha</label>
                    <input asp-for="Password" class="form-input" autocomplete="new-password" />
                    <span asp-validation-for="Password"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="form-label">Confirmar senha</label>
                    <input asp-for="ConfirmPassword" class="form-input" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>

                <button type="submit" class="btn-primary w-full">Criar minha conta</button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-400">
                Já tem conta?
                <a class="font-semibold text-emerald-300 hover:text-emerald-200" asp-action="Login">Entrar</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
