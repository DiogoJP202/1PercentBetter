@model NoteFormViewModel

<form class="app-card space-y-5 p-6" method="post">
    <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3"></div>

    <div class="grid gap-4 md:grid-cols-2">
        <div>
            <label asp-for="Title" class="form-label">Titulo</label>
            <input asp-for="Title" class="form-input" />
            <span asp-validation-for="Title"></span>
        </div>
        <div>
            <label asp-for="Date" class="form-label">Data</label>
            <input asp-for="Date" class="form-input" />
        </div>
    </div>

    <div>
        <label asp-for="Content" class="form-label">Conteudo</label>
        <textarea asp-for="Content" class="form-textarea"></textarea>
        <span asp-validation-for="Content"></span>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
        <div>
            <label asp-for="NoteType" class="form-label">Tipo</label>
            <select asp-for="NoteType" asp-items="Html.GetEnumSelectList<NoteType>()" class="form-select"></select>
        </div>
        <div>
            <label asp-for="Tags" class="form-label">Tags</label>
            <input asp-for="Tags" class="form-input" />
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div>
            <label asp-for="IdentityId" class="form-label">Identidade</label>
            <select asp-for="IdentityId" class="form-select">
                <option value="">Nenhuma</option>
                @foreach (var identity in Model.Identities)
                {
                    <option value="@identity.Value">@identity.Text</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="GoalId" class="form-label">Objetivo</label>
            <select asp-for="GoalId" class="form-select">
                <option value="">Nenhum</option>
                @foreach (var goal in Model.Goals)
                {
                    <option value="@goal.Value">@goal.Text</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="HabitId" class="form-label">Habito</label>
            <select asp-for="HabitId" class="form-select">
                <option value="">Nenhum</option>
                @foreach (var habit in Model.Habits)
                {
                    <option value="@habit.Value">@habit.Text</option>
                }
            </select>
        </div>
    </div>

    <div class="flex flex-wrap justify-end gap-2">
        <a class="btn-secondary" asp-action="Index">Cancelar</a>
        <button class="btn-primary" type="submit">Salvar</button>
    </div>
</form>
