@model NoteFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    var previewTitle = string.IsNullOrWhiteSpace(Model.Title) ? "Sua nova anotacao" : Model.Title;
    var previewContent = string.IsNullOrWhiteSpace(Model.Content)
        ? "Descreva fatos, sinais e proximos passos para transformar observacoes em melhoria continua."
        : Model.Content;
    var previewDate = Model.Date == default ? DateTime.Today : Model.Date;
    var titleLength = Model.Title?.Length ?? 0;
    var contentLength = Model.Content?.Length ?? 0;
    var initialTags = string.IsNullOrWhiteSpace(Model.Tags)
        ? Array.Empty<string>()
        : Model.Tags
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
}

<form class="app-card space-y-6 p-6" method="post" autocomplete="off" data-note-form>
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3"></div>

    <section class="rounded-2xl border border-white/10 bg-white/[0.03] p-4" data-note-preview>
        <div class="flex items-start gap-4">
            <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl border border-white/10 bg-slate-950/50 text-violet-300">
                <i data-lucide="notebook-pen" class="h-7 w-7"></i>
            </span>
            <div class="min-w-0">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Preview da anotacao</p>
                <h2 class="mt-1 truncate text-2xl font-black text-white" data-note-preview-title>@previewTitle</h2>
                <p class="mt-2 text-sm leading-6 text-slate-300" data-note-preview-content>@previewContent</p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                    <span class="status-pill status-pill-info" data-note-preview-type>@Model.NoteType.ToDisplayName()</span>
                    <span class="status-pill status-pill-neutral" data-note-preview-date>@previewDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="mt-3 flex flex-wrap gap-2" data-note-preview-tags>
                    @if (initialTags.Any())
                    {
                        @foreach (var tag in initialTags)
                        {
                            <span class="status-pill status-pill-neutral">@tag</span>
                        }
                    }
                    else
                    {
                        <span class="text-xs text-slate-500">Sem tags por enquanto.</span>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <div class="text-sm font-bold text-white">Foco na utilidade</div>
            <p class="mt-2 text-xs leading-5 text-slate-400">Escreva para facilitar revisao e decisao futura, nao para ficar perfeito agora.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <div class="text-sm font-bold text-white">Contexto breve</div>
            <p class="mt-2 text-xs leading-5 text-slate-400">Inclua situacao, sinal observado e impacto no seu dia para tornar o registro acionavel.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <div class="text-sm font-bold text-white">Feche com proximo passo</div>
            <p class="mt-2 text-xs leading-5 text-slate-400">Sempre que possivel, termine com um ajuste simples para o proximo ciclo.</p>
        </div>
    </section>

    <div>
        <label asp-for="Title" class="form-label">Titulo</label>
        <input asp-for="Title" class="form-input" placeholder="Ex.: Ajuste no estudo noturno" data-note-title-input />
        <div class="mt-2 flex items-center justify-between gap-2 text-xs text-slate-500">
            <p>Use um titulo curto para localizar essa anotacao em segundos.</p>
            <span data-note-title-counter>@titleLength/160</span>
        </div>
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label asp-for="Content" class="form-label">Conteudo</label>
        <textarea asp-for="Content" class="form-textarea" placeholder="O que aconteceu? O que aprendi? Qual ajuste vou testar?" data-note-content-input></textarea>
        <div class="mt-2 flex items-center justify-between gap-2 text-xs text-slate-500">
            <p>Transforme observacao em acao clara e testavel.</p>
            <span data-note-content-counter>@contentLength/6000</span>
        </div>
        <span asp-validation-for="Content"></span>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div>
            <label asp-for="Date" class="form-label">Data</label>
            <input asp-for="Date" class="form-input" data-note-date-input />
            <p class="mt-2 text-xs text-slate-500">Data de referencia do registro.</p>
            <span asp-validation-for="Date"></span>
        </div>
        <div>
            <label asp-for="NoteType" class="form-label">Tipo</label>
            <select asp-for="NoteType" asp-items="@(EnumDisplayExtensions.ToSelectList<NoteType>())" class="form-select" data-note-type-input></select>
            <p class="mt-2 text-xs text-slate-500">Classifique para filtrar melhor depois.</p>
            <span asp-validation-for="NoteType"></span>
        </div>
        <div>
            <label asp-for="Tags" class="form-label">Tags</label>
            <input asp-for="Tags" class="form-input" placeholder="ex.: foco, energia, estudo" data-note-tags-input />
            <p class="mt-2 text-xs text-slate-500">Separe por virgula para criar multiplas tags.</p>
            <span asp-validation-for="Tags"></span>
        </div>
    </div>

    <section class="space-y-4">
        <div>
            <h3 class="text-lg font-black text-white">Vinculos opcionais</h3>
            <p class="mt-1 text-sm text-slate-400">Conecte a anotacao com identidade, objetivo e habito quando isso ajudar na leitura do contexto.</p>
        </div>

        <div class="grid gap-4 md:grid-cols-4">
            <div>
                <label asp-for="IdentityId" class="form-label">Identidade</label>
                <select asp-for="IdentityId" class="form-select">
                    <option value="">Nenhuma</option>
                    @foreach (var identity in Model.Identities)
                    {
                        <option value="@identity.Value">@identity.Text</option>
                    }
                </select>
                <span asp-validation-for="IdentityId"></span>
            </div>
            <div>
                <label asp-for="GoalId" class="form-label">Objetivo</label>
                <select asp-for="GoalId" class="form-select">
                    <option value="">Nenhum</option>
                    @foreach (var goal in Model.Goals)
                    {
                        <option value="@goal.Value">@goal.Text</option>
                    }
                </select>
                <span asp-validation-for="GoalId"></span>
            </div>
            <div>
                <label asp-for="HabitId" class="form-label">Habito</label>
                <select asp-for="HabitId" class="form-select">
                    <option value="">Nenhum</option>
                    @foreach (var habit in Model.Habits)
                    {
                        <option value="@habit.Value">@habit.Text</option>
                    }
                </select>
                <span asp-validation-for="HabitId"></span>
            </div>
            <div>
                <label asp-for="TaskItemId" class="form-label">Tarefa</label>
                <select asp-for="TaskItemId" class="form-select">
                    <option value="">Nenhuma</option>
                    @foreach (var task in Model.TaskItems)
                    {
                        <option value="@task.Value">@task.Text</option>
                    }
                </select>
                <span asp-validation-for="TaskItemId"></span>
            </div>
        </div>
    </section>

    <div class="flex flex-wrap justify-end gap-2">
        <a class="btn-secondary" asp-action="Index">
            <i data-lucide="x" class="h-4 w-4"></i>
            Cancelar
        </a>
        <button class="btn-primary" type="submit">
            <i data-lucide="save" class="h-4 w-4"></i>
            @(isEdit ? "Salvar ajustes" : "Salvar anotacao")
        </button>
    </div>
</form>
