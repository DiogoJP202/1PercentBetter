@model NoteDetailsViewModel
@{
    ViewData["Title"] = "Detalhes da anotação";

    IReadOnlyList<string> ParseTags(string? rawTags)
    {
        if (string.IsNullOrWhiteSpace(rawTags))
        {
            return [];
        }

        return rawTags
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    var tags = ParseTags(Model.Tags);

    string TypePillClass(NoteType noteType) => noteType switch
    {
        NoteType.Victory => "status-pill-success",
        NoteType.Difficulty => "status-pill-danger",
        NoteType.SystemAdjustment => "status-pill-warning",
        NoteType.Learning => "status-pill-info",
        NoteType.WeeklyReview or NoteType.MonthlyReview => "status-pill-warning",
        _ => "status-pill-neutral"
    };
}

<div class="mx-auto max-w-5xl space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-violet-300">Anotações</p>
            <h1 class="mt-1 text-3xl font-black text-white sm:text-4xl">Detalhes da anotação</h1>
            <p class="mt-2 text-sm text-slate-400">Revise o contexto completo antes de editar seu sistema.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a class="btn-secondary" asp-action="Index">
                <i data-lucide="arrow-left" class="h-4 w-4"></i>
                Voltar
            </a>
            <a class="btn-primary" asp-action="Edit" asp-route-id="@Model.Id">
                <i data-lucide="pencil" class="h-4 w-4"></i>
                Editar
            </a>
            <form method="post"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  data-confirm
                  data-confirm-tone="danger"
                  data-confirm-title="Excluir anotação?"
                  data-confirm-text="A anotação será removida da lista, mas ficará salva como exclusão lógica."
                  data-confirm-button="Excluir anotação">
                @Html.AntiForgeryToken()
                <button class="btn-danger" type="submit">
                    <i data-lucide="trash-2" class="h-4 w-4"></i>
                    Excluir
                </button>
            </form>
        </div>
    </div>

    <section class="app-card p-6">
        <div class="flex flex-wrap items-center gap-2">
            <span class="status-pill @TypePillClass(Model.NoteType)">@Model.NoteType.ToDisplayName()</span>
            <span class="status-pill status-pill-neutral">@Model.Date.ToString("dd/MM/yyyy")</span>
        </div>

        <h2 class="mt-4 text-3xl font-black text-white">@Model.Title</h2>

        <p class="mt-4 whitespace-pre-line text-sm leading-7 text-slate-200">@Model.Content</p>

        @if (tags.Any())
        {
            <div class="mt-5 flex flex-wrap gap-2">
                @foreach (var tag in tags)
                {
                    <span class="status-pill status-pill-neutral">#@tag</span>
                }
            </div>
        }
    </section>

    <section class="grid gap-4 md:grid-cols-2">
        <div class="app-card p-5">
            <h3 class="text-lg font-black text-white">Vínculos</h3>
            <div class="mt-3 space-y-2 text-sm">
                <p class="text-slate-300"><span class="text-slate-500">Identidade:</span> @(string.IsNullOrWhiteSpace(Model.IdentityName) ? "Nenhuma" : Model.IdentityName)</p>
                <p class="text-slate-300"><span class="text-slate-500">Objetivo:</span> @(string.IsNullOrWhiteSpace(Model.GoalTitle) ? "Nenhum" : Model.GoalTitle)</p>
                <p class="text-slate-300"><span class="text-slate-500">Hábito:</span> @(string.IsNullOrWhiteSpace(Model.HabitTitle) ? "Nenhum" : Model.HabitTitle)</p>
                <p class="text-slate-300"><span class="text-slate-500">Tarefa:</span> @(string.IsNullOrWhiteSpace(Model.TaskTitle) ? "Nenhuma" : Model.TaskTitle)</p>
            </div>
        </div>

        <div class="app-card p-5">
            <h3 class="text-lg font-black text-white">Metadados</h3>
            <div class="mt-3 space-y-2 text-sm">
                <p class="text-slate-300"><span class="text-slate-500">Criada em:</span> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="text-slate-300"><span class="text-slate-500">Última atualização:</span> @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </section>
</div>
