@model IReadOnlyList<NoteListItemViewModel>
@{
    ViewData["Title"] = "Anotacoes";
}

<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-violet-300">Anotacoes</p>
            <h1 class="mt-1 text-3xl font-black text-white">Registro de evolucao</h1>
        </div>
        <a class="btn-primary" asp-action="Create"><i data-lucide="plus" class="h-4 w-4"></i>Nova anotacao</a>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
        @foreach (var item in Model)
        {
            <article class="app-card p-5">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h2 class="text-lg font-black text-white">@item.Title</h2>
                        <p class="mt-1 text-sm text-slate-400">@item.Date.ToString("dd/MM/yyyy") - @item.NoteType.ToDisplayName()</p>
                    </div>
                    <a class="btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                </div>
                <p class="mt-4 text-sm leading-6 text-slate-300">@item.ContentPreview</p>
                @if (!string.IsNullOrWhiteSpace(item.Tags))
                {
                    <p class="mt-4 text-xs font-semibold text-violet-200">@item.Tags</p>
                }
            </article>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="app-card p-8 text-center text-slate-400">Nenhuma anotacao criada ainda.</div>
    }
</div>
