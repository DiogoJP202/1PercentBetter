@model IReadOnlyList<NoteListItemViewModel>
@{
    ViewData["Title"] = "Anotações";

    var today = DateTime.Today;
    var weekStart = today.AddDays(-6);
    var totalNotes = Model.Count;
    var notesThisWeek = Model.Count(item => item.Date.Date >= weekStart && item.Date.Date <= today);
    var notesWithTags = Model.Count(item => !string.IsNullOrWhiteSpace(item.Tags));
    var topTypeGroup = Model
        .GroupBy(item => item.NoteType)
        .OrderByDescending(group => group.Count())
        .ThenBy(group => group.Key)
        .FirstOrDefault();

    var topTypeLabel = topTypeGroup is null
        ? "Sem dados ainda"
        : $"{topTypeGroup.Key.ToDisplayName()} ({topTypeGroup.Count()})";

    var latestDateLabel = Model.Any()
        ? Model.Max(item => item.Date).ToString("dd/MM/yyyy")
        : "Nenhuma anotação";

    IReadOnlyList<string> ParseTags(string? rawTags)
    {
        if (string.IsNullOrWhiteSpace(rawTags))
        {
            return [];
        }

        return rawTags
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    string TypePillClass(NoteType noteType) => noteType switch
    {
        NoteType.Victory => "status-pill-success",
        NoteType.Difficulty => "status-pill-danger",
        NoteType.SystemAdjustment => "status-pill-warning",
        NoteType.Learning => "status-pill-info",
        NoteType.WeeklyReview or NoteType.MonthlyReview => "status-pill-warning",
        _ => "status-pill-neutral"
    };
}

<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div data-tour-anchor="notes-overview">
            <p class="text-sm font-semibold text-violet-300">Anotações</p>
            <h1 class="mt-1 text-3xl font-black text-white sm:text-4xl">Biblioteca de aprendizados</h1>
            <p class="mt-2 max-w-2xl text-sm text-slate-400">Use as anotações para registrar sinais de progresso, dificuldades e ajustes do sistema antes que eles se percam na rotina.</p>
        </div>
        <a class="btn-primary" asp-action="Create">
            <i data-lucide="plus" class="h-4 w-4"></i>
            Nova anotação
        </a>
    </div>

    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Total de anotações</div>
            <div class="mt-3 text-4xl font-black text-violet-300">@totalNotes</div>
            <p class="mt-2 text-xs text-slate-500">Histórico acumulado no seu sistema.</p>
        </div>
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Últimos 7 dias</div>
            <div class="mt-3 text-4xl font-black text-emerald-300">@notesThisWeek</div>
            <p class="mt-2 text-xs text-slate-500">Ritmo recente de registro.</p>
        </div>
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Com tags</div>
            <div class="mt-3 text-4xl font-black text-white">@notesWithTags</div>
            <p class="mt-2 text-xs text-slate-500">Facilita busca e revisão.</p>
        </div>
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Tipo mais frequente</div>
            <div class="mt-3 truncate text-xl font-black text-slate-100">@topTypeLabel</div>
            <p class="mt-2 text-xs text-slate-500">Último registro: @latestDateLabel</p>
        </div>
    </section>

    <section class="app-card p-5" data-tour-anchor="notes-reviews">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <h2 class="text-xl font-black text-white">Revisões semanais e mensais</h2>
                <p class="mt-2 text-sm text-slate-400">
                    Reserve um momento para escrever uma nota de revisão semanal ou mensal.
                    Esse ritual transforma observação em ajuste prático no sistema.
                </p>
            </div>
            <a class="btn-secondary" asp-action="Create">
                <i data-lucide="calendar-clock" class="h-4 w-4"></i>
                Nova revisão
            </a>
        </div>
    </section>

    @if (!Model.Any())
    {
        <section class="app-card p-8 text-center">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-violet-300/20 bg-violet-300/10 text-violet-300">
                <i data-lucide="notebook-pen" class="h-7 w-7"></i>
            </div>
            <h2 class="mt-5 text-2xl font-black text-white">Você ainda não registrou anotações.</h2>
            <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-400">Comece com uma nota curta sobre o que funcionou hoje. Em poucos dias, você vai ter material suficiente para ajustar hábitos com mais clareza.</p>
            <a class="btn-primary mt-5" asp-action="Create">
                <i data-lucide="plus" class="h-4 w-4"></i>
                Criar primeira anotação
            </a>
        </section>
    }
    else
    {
        <section class="grid gap-4 lg:grid-cols-2">
            @foreach (var item in Model)
            {
                var tags = ParseTags(item.Tags);

                <article class="app-card p-5">
                    <div class="flex flex-col gap-4 md:grid md:grid-cols-[1fr_auto] md:items-start">
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="status-pill @TypePillClass(item.NoteType)">@item.NoteType.ToDisplayName()</span>
                                <span class="text-xs font-semibold text-slate-500">Data: @item.Date.ToString("dd/MM/yyyy")</span>
                            </div>
                            <h2 class="mt-3 truncate text-xl font-black text-white">@item.Title</h2>
                        </div>
                        <a class="btn-secondary" asp-action="Edit" asp-route-id="@item.Id">
                            <i data-lucide="pencil" class="h-4 w-4"></i>
                            Editar
                        </a>
                    </div>

                    <p class="mt-4 text-sm leading-6 text-slate-300">@item.ContentPreview</p>

                    <div class="mt-5 grid gap-3 md:grid-cols-2">
                        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-3">
                            <div class="text-xs text-slate-500">Classificação</div>
                            <div class="mt-1 text-sm font-bold text-slate-200">@item.NoteType.ToDisplayName()</div>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-3">
                            <div class="text-xs text-slate-500">Tags registradas</div>
                            <div class="mt-1 text-sm font-bold text-slate-200">@tags.Count</div>
                        </div>
                    </div>

                    @if (tags.Any())
                    {
                        <div class="mt-4 flex flex-wrap gap-2">
                            @foreach (var tag in tags.Take(6))
                            {
                                <span class="status-pill status-pill-neutral">@tag</span>
                            }
                        </div>
                    }
                </article>
            }
        </section>
    }
</div>
