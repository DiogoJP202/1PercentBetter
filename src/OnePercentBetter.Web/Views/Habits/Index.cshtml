@model IReadOnlyList<HabitListItemViewModel>
@{
    ViewData["Title"] = "Habitos";
}

<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-emerald-300">Habitos</p>
            <h1 class="mt-1 text-3xl font-black text-white">Pequenas acoes, todos os dias</h1>
        </div>
        <a class="btn-primary" asp-action="Create"><i data-lucide="plus" class="h-4 w-4"></i>Novo habito</a>
    </div>

    <div class="grid gap-4">
        @foreach (var item in Model)
        {
            <article class="app-card p-5">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                    <div class="min-w-0">
                        <div class="flex items-center gap-3">
                            <span class="grid h-10 w-10 place-items-center rounded-xl border border-white/10" style="color:@item.Color">
                                <i data-lucide="@item.Icon" class="h-5 w-5"></i>
                            </span>
                            <div class="min-w-0">
                                <h2 class="truncate text-lg font-black text-white">@item.Title</h2>
                                <p class="truncate text-sm text-slate-400">@item.IdentityName - @item.GoalTitle</p>
                            </div>
                        </div>
                        <div class="mt-4 grid gap-3 md:grid-cols-2">
                            <p class="rounded-xl bg-slate-950/60 px-3 py-2 text-sm text-slate-300">@item.Trigger</p>
                            <p class="rounded-xl bg-slate-950/60 px-3 py-2 text-sm text-slate-300">@item.TwoMinuteVersion</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <span class="status-pill">Hoje: @(item.TodayStatus?.ToDisplayName() ?? "Pendente")</span>
                        <a class="btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <form asp-action="Complete" asp-route-id="@item.Id" method="post">
                            <button class="btn-primary" type="submit">Concluir</button>
                        </form>
                        <form asp-action="Fail" asp-route-id="@item.Id" method="post">
                            <button class="btn-danger" type="submit">Falhei</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="app-card p-8 text-center text-slate-400">Nenhum habito criado ainda.</div>
    }
</div>
