@model IReadOnlyList<HabitListItemViewModel>
@{
    ViewData["Title"] = "Hábitos";

    var pendingTodayHabits = Model
        .Where(item => item.IsDueToday && item.TodayStatus is null)
        .ToList();

    var resolvedTodayHabits = Model
        .Where(item => item.IsDueToday && item.TodayStatus is not null)
        .ToList();

    var notDueTodayHabits = Model
        .Where(item => !item.IsDueToday)
        .ToList();
}

<div class="space-y-6" data-habits-board>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div data-tour-anchor="habits-good">
            <p class="text-sm font-semibold text-emerald-300">Hábitos</p>
            <h1 class="mt-1 text-3xl font-black text-white">Pequenas ações, todos os dias</h1>
        </div>
        <a class="btn-primary" asp-action="Create"><i data-lucide="plus" class="h-4 w-4"></i>Novo hábito</a>
    </div>

    <section class="grid gap-4 lg:grid-cols-2">
        <article class="app-card p-5">
            <h2 class="text-lg font-black text-white">Hábitos bons</h2>
            <p class="mt-2 text-sm text-slate-400">
                Foque em ações pequenas e repetíveis. Cada conclusão reforça sua identidade.
            </p>
        </article>
        <article class="app-card p-5" data-tour-anchor="habits-bad">
            <h2 class="text-lg font-black text-white">Hábitos ruins</h2>
            <p class="mt-2 text-sm text-slate-400">
                Quando um comportamento ruim aparecer, registre falha ou pulo e ajuste gatilho, ambiente e dificuldade.
            </p>
        </article>
    </section>

    <section class="rounded-2xl border border-sky-300/20 bg-sky-300/10 p-4 text-sm text-sky-100">
        Hábito é comportamento recorrente. Para ação pontual, com começo e fim, use
        <a class="font-bold text-sky-200 underline underline-offset-4" asp-controller="Tasks" asp-action="Index">Tarefas</a>.
    </section>

    @if (!Model.Any())
    {
        <div class="app-card p-8 text-center text-slate-400">Nenhum hábito criado ainda.</div>
    }
    else
    {
        <div class="space-y-6" data-habits-list>
            <section class="space-y-3">
                <h2 class="text-lg font-black text-violet-200">Pendentes de hoje</h2>
                <div class="space-y-3" data-habit-open-list>
                    @if (!pendingTodayHabits.Any())
                    {
                        <div class="rounded-2xl border border-dashed border-white/15 p-4 text-sm text-slate-400" data-habit-open-empty>
                            Nenhum hábito pendente para hoje.
                        </div>
                    }
                    else
                    {
                        @foreach (var item in pendingTodayHabits)
                        {
                            <partial name="_HabitCard" model="item" />
                        }
                    }
                </div>
            </section>

            <section class="space-y-3">
                <h2 class="text-lg font-black text-emerald-200">Registrados hoje</h2>
                <div class="space-y-3" data-habit-resolved-list>
                    @if (!resolvedTodayHabits.Any())
                    {
                        <div class="rounded-2xl border border-dashed border-white/15 p-4 text-sm text-slate-400" data-habit-resolved-empty>
                            Ainda não há hábitos registrados hoje.
                        </div>
                    }
                    else
                    {
                        @foreach (var item in resolvedTodayHabits)
                        {
                            <partial name="_HabitCard" model="item" />
                        }
                    }
                </div>
            </section>

            <section class="space-y-3">
                <h2 class="text-lg font-black text-slate-200">Não planejados hoje</h2>
                <div class="space-y-3" data-habit-future-list>
                    @if (!notDueTodayHabits.Any())
                    {
                        <div class="rounded-2xl border border-dashed border-white/15 p-4 text-sm text-slate-400" data-habit-future-empty>
                            Todos os hábitos ativos estão planejados para hoje.
                        </div>
                    }
                    else
                    {
                        @foreach (var item in notDueTodayHabits)
                        {
                            <partial name="_HabitCard" model="item" />
                        }
                    }
                </div>
            </section>
        </div>
    }
</div>

@section Scripts {
    <script type="module" src="~/js/modules/daily-actions.js" asp-append-version="true"></script>
}
