@model HabitListItemViewModel
@{
    var todayPillClass = !Model.IsDueToday ? "status-pill-neutral" : Model.TodayStatus switch
    {
        HabitLogStatus.Completed => "status-pill-success",
        HabitLogStatus.Failed => "status-pill-danger",
        HabitLogStatus.Skipped => "status-pill-warning",
        HabitLogStatus.Partial => "status-pill-info",
        _ => "status-pill-warning"
    };
    var todayIcon = !Model.IsDueToday ? "calendar-minus" : Model.TodayStatus switch
    {
        HabitLogStatus.Completed => "check",
        HabitLogStatus.Failed => "x",
        HabitLogStatus.Skipped => "skip-forward",
        HabitLogStatus.Partial => "circle-dashed",
        _ => "clock"
    };
    var todayStatusLabel = Model.IsDueToday
        ? Model.TodayStatus?.ToDisplayName() ?? "Pendente"
        : "Não planejado hoje";
    var statusPillClass = Model.Status switch
    {
        ItemStatus.Active => "status-pill-success",
        ItemStatus.Paused => "status-pill-warning",
        ItemStatus.Completed => "status-pill-info",
        ItemStatus.Canceled => "status-pill-danger",
        _ => "status-pill-neutral"
    };

    var sortKey = Model.SuggestedTime.HasValue
        ? Model.SuggestedTime.Value.ToString("hh\\:mm")
        : "99:99";
}

<article class="app-card p-5"
         data-habit-card
         data-habit-id="@Model.Id"
         data-habit-due-today="@Model.IsDueToday.ToString().ToLowerInvariant()"
         data-habit-resolved-today="@(Model.TodayStatus.HasValue ? "true" : "false")"
         data-habit-sort-key="@sortKey"
         data-habit-title="@Model.Title">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0">
            <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-xl border border-white/10" style="color:@Model.Color">
                    <i data-lucide="@Model.Icon" class="h-5 w-5"></i>
                </span>
                <div class="min-w-0">
                    <h2 class="truncate text-lg font-black text-white">@Model.Title</h2>
                    <p class="truncate text-sm text-slate-400">@(string.Join(" - ", new[] { Model.IdentityName, Model.GoalTitle }.Where(value => !string.IsNullOrWhiteSpace(value))))</p>
                    <div class="mt-2 flex flex-wrap gap-2">
                        <span class="status-pill status-pill-info"><i data-lucide="repeat-2"></i>@Model.FrequencyType.ToDisplayName()</span>
                        <span class="status-pill @statusPillClass"><i data-lucide="activity"></i>@Model.Status.ToDisplayName()</span>
                        @if (Model.SuggestedTime.HasValue)
                        {
                            <span class="status-pill status-pill-neutral">
                                <i data-lucide="clock"></i>
                                @Model.SuggestedTime.Value.ToString(@"hh\:mm")
                                @if (Model.EndTime.HasValue)
                                {
                                    <span> - @Model.EndTime.Value.ToString(@"hh\:mm")</span>
                                }
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.LocationName))
                        {
                            <span class="status-pill status-pill-neutral"><i data-lucide="map-pin"></i>@Model.LocationName</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.StackedAfterText))
                    {
                        <p class="mt-2 text-xs text-slate-500">Depois de @Model.StackedAfterText, eu irei @Model.Title.</p>
                    }
                </div>
            </div>
            <div class="mt-4 grid gap-3 md:grid-cols-2">
                <p class="rounded-xl bg-slate-950/60 px-3 py-2 text-sm text-slate-300">@Model.Trigger</p>
                <p class="rounded-xl bg-slate-950/60 px-3 py-2 text-sm text-slate-300">@Model.TwoMinuteVersion</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2" data-habit-actions>
            <span class="status-pill @todayPillClass" data-habit-today-pill><i data-lucide="@todayIcon"></i>Hoje: @todayStatusLabel</span>
            <a class="btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  data-confirm
                  data-confirm-tone="danger"
                  data-confirm-title="Excluir hábito?"
                  data-confirm-text="O hábito será removido da lista ativa, sem apagar dados já registrados."
                  data-confirm-button="Excluir hábito">
                @Html.AntiForgeryToken()
                <button class="btn-danger" type="submit">Excluir</button>
            </form>
            @if (Model.IsDueToday)
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post"
                      data-async-action
                      data-action-kind="complete"
                      data-success-message="Hábito concluído."
                      data-habit-status-form>
                    <button class="btn-primary" type="submit">Concluir</button>
                </form>
                <form asp-action="Fail" asp-route-id="@Model.Id" method="post"
                      data-async-action
                      data-action-kind="fail"
                      data-success-message="Falha registrada."
                      data-habit-status-form
                      data-confirm
                      data-confirm-tone="danger"
                      data-confirm-title="Registrar falha?"
                      data-confirm-text="Isso marcará este hábito como falhou hoje."
                      data-confirm-button="Registrar falha">
                    <button class="btn-danger" type="submit">Falhei</button>
                </form>
                <form asp-action="Skip" asp-route-id="@Model.Id" method="post"
                      data-async-action
                      data-action-kind="skip"
                      data-success-message="Hábito pulado hoje."
                      data-habit-status-form
                      data-confirm
                      data-confirm-title="Pular hábito hoje?"
                      data-confirm-text="Isso registrará o hábito como pulado no dia atual."
                      data-confirm-button="Pular hoje">
                    <button class="btn-secondary" type="submit">Pular</button>
                </form>
            }
            else
            {
                <span class="status-pill status-pill-neutral">Sem ação hoje</span>
            }
        </div>
    </div>
</article>
