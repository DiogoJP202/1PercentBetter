@model TaskItemFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    var selectedIcon = TaskVisualOptions.Icons.FirstOrDefault(icon => icon.Value == Model.Icon) ?? TaskVisualOptions.Icons.First();
}

<form class="app-card space-y-6 p-6"
      method="post"
      autocomplete="off"
      data-task-form
      data-task-tag-save-url="@Url.Action("SaveTag", "Tasks")"
      data-task-tag-delete-url="@Url.Action("DeleteTag", "Tasks")">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3"></div>

    <section class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
        <div class="flex items-start gap-4">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl border border-white/10 bg-slate-950/50" style="color:@Model.Color" data-task-preview-icon>
                <i data-lucide="@selectedIcon.Value" class="h-6 w-6"></i>
            </span>
            <div class="min-w-0">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Ação pontual</p>
                <h2 class="mt-1 truncate text-2xl font-black text-white" data-task-preview-title>@(string.IsNullOrWhiteSpace(Model.Title) ? "Sua próxima ação" : Model.Title)</h2>
                <p class="mt-2 text-sm text-slate-400">
                    Tarefas são ações pontuais com começo e fim.
                    Se você pretende repetir essa ação com frequência, prefira criar um hábito.
                </p>
                <p class="mt-3 hidden rounded-xl border border-amber-300/30 bg-amber-300/10 px-3 py-2 text-xs text-amber-100" data-task-recurrence-warning>
                    Isso parece recorrente. Talvez funcione melhor como hábito.
                </p>
            </div>
        </div>
    </section>

    <div class="grid gap-4 md:grid-cols-2">
        <div>
            <label asp-for="Title" class="form-label">Título</label>
            <input asp-for="Title" class="form-input" placeholder="Ex.: Criar controller de tarefas" data-task-title-input />
            <span asp-validation-for="Title"></span>
        </div>
        <div>
            <label asp-for="Priority" class="form-label">Prioridade</label>
            <select asp-for="Priority" asp-items="@(EnumDisplayExtensions.ToSelectList<TaskItemPriority>())" class="form-select"></select>
            <span asp-validation-for="Priority"></span>
        </div>
    </div>

    <div>
        <label asp-for="Description" class="form-label">Descrição</label>
        <textarea asp-for="Description" class="form-textarea" placeholder="Descreva a entrega objetiva desta tarefa." data-task-description-input></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div>
        <label asp-for="Notes" class="form-label">Observações</label>
        <textarea asp-for="Notes" class="form-textarea" placeholder="Contexto extra, bloqueios ou detalhes técnicos."></textarea>
        <span asp-validation-for="Notes"></span>
    </div>

    <section class="grid gap-4 md:grid-cols-4">
        <div>
            <label asp-for="TaskDate" class="form-label">Data da tarefa</label>
            <input asp-for="TaskDate" class="form-input" />
            <span asp-validation-for="TaskDate"></span>
        </div>
        <div>
            <label asp-for="StartTime" class="form-label">Horário inicial</label>
            <input asp-for="StartTime" class="form-input" />
            <span asp-validation-for="StartTime"></span>
        </div>
        <div>
            <label asp-for="EndTime" class="form-label">Horário final</label>
            <input asp-for="EndTime" class="form-input" />
            <span asp-validation-for="EndTime"></span>
        </div>
        <div>
            <label asp-for="DueDate" class="form-label">Prazo</label>
            <input asp-for="DueDate" class="form-input" />
            <span asp-validation-for="DueDate"></span>
        </div>
    </section>

    <section class="grid gap-4 md:grid-cols-2">
        <div>
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" asp-items="@(EnumDisplayExtensions.ToSelectList<TaskItemStatus>())" class="form-select"></select>
            <span asp-validation-for="Status"></span>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <label class="inline-flex items-center gap-2 text-sm font-semibold text-slate-200">
                <input asp-for="ShowOnCalendar" class="h-4 w-4 accent-emerald-400" />
                Mostrar no calendário
            </label>
            <p class="mt-2 text-xs text-slate-500">Apenas tarefas com data aparecem no calendário.</p>
        </div>
    </section>

    <section class="grid gap-4 md:grid-cols-4">
        <div>
            <label asp-for="IdentityId" class="form-label">Identidade</label>
            <select asp-for="IdentityId" class="form-select">
                <option value="">Nenhuma</option>
                @foreach (var identity in Model.Identities)
                {
                    <option value="@identity.Value">@identity.Text</option>
                }
            </select>
            <span asp-validation-for="IdentityId"></span>
        </div>
        <div>
            <label asp-for="GoalId" class="form-label">Objetivo</label>
            <select asp-for="GoalId" class="form-select">
                <option value="">Nenhum</option>
                @foreach (var goal in Model.Goals)
                {
                    <option value="@goal.Value">@goal.Text</option>
                }
            </select>
            <span asp-validation-for="GoalId"></span>
        </div>
        <div>
            <label asp-for="HabitId" class="form-label">Hábito relacionado</label>
            <select asp-for="HabitId" class="form-select">
                <option value="">Nenhum</option>
                @foreach (var habit in Model.Habits)
                {
                    <option value="@habit.Value">@habit.Text</option>
                }
            </select>
            <span asp-validation-for="HabitId"></span>
        </div>
        <div>
            <label asp-for="CategoryId" class="form-label">Categoria</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">Sem categoria</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value">@category.Text</option>
                }
            </select>
            <span asp-validation-for="CategoryId"></span>
        </div>
    </section>

    <section class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <label asp-for="SelectedTagIds" class="form-label">Tags</label>
                <p class="mt-1 text-xs text-slate-500">Selecione as tags relacionadas a esta tarefa.</p>
            </div>
            <button type="button" class="btn-secondary" data-task-tags-open>
                <i data-lucide="tags" class="h-4 w-4"></i>
                Gerenciar tags
            </button>
        </div>

        <p class="rounded-xl border border-dashed border-white/15 p-4 text-sm text-slate-400 @(Model.TagItems.Any() ? "hidden" : string.Empty)" data-task-tag-empty>
            Nenhuma tag cadastrada ainda. Use "Gerenciar tags" para criar a primeira.
        </p>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 @(Model.TagItems.Any() ? string.Empty : "hidden")" data-task-tag-chip-list>
            @foreach (var tag in Model.TagItems)
            {
                var tagInputId = $"task-tag-{tag.Id}";
                <label for="@tagInputId"
                        class="group cursor-pointer"
                        data-task-tag-chip-row="@tag.Id">
                    <input id="@tagInputId"
                            type="checkbox"
                            name="SelectedTagIds"
                            value="@tag.Id"
                            checked="@Model.SelectedTagIds.Contains(tag.Id)"
                            class="peer sr-only"
                            data-task-tag-checkbox="@tag.Id" />
                    <span class="flex min-h-24 flex-col justify-center rounded-2xl border border-white/10 bg-white/[0.03] p-4 transition hover:border-emerald-300/60 hover:bg-emerald-300/10 peer-checked:border-emerald-300 peer-checked:bg-emerald-300/15 peer-checked:shadow-[0_0_0_1px_rgba(110,231,183,0.35)]">
                        <span class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 transition peer-checked:text-white">
                            <span class="h-2.5 w-2.5 rounded-full" style="background:@tag.Color" data-task-tag-chip-dot></span>
                            <span data-task-tag-chip-name>@tag.Name</span>
                        </span>
                        <span class="mt-2 text-xs text-slate-500 transition group-hover:text-slate-300">Clique para selecionar.</span>
                    </span>
                </label>
            }
        </div>
        <span asp-validation-for="SelectedTagIds"></span>

        <div>
            <label asp-for="NewTags" class="form-label">Criar novas tags rapidamente</label>
            <input asp-for="NewTags" class="form-input" placeholder="ex.: estudo, projeto, urgente" />
            <p class="mt-2 text-xs text-slate-500">Separe por vírgula para criar várias de uma vez.</p>
            <span asp-validation-for="NewTags"></span>
        </div>
    </section>

    <section class="grid gap-4 md:grid-cols-2">
        <div>
            <label asp-for="Color" class="form-label">Cor</label>
            <div class="flex items-center gap-3">
                <input asp-for="Color" type="color" class="h-12 w-16 cursor-pointer rounded-xl border border-white/10 bg-slate-950 p-1" data-task-color-input />
                <div class="flex flex-wrap gap-2">
                    @foreach (var color in TaskVisualOptions.Colors)
                    {
                        <button type="button" class="h-9 w-9 rounded-full border border-white/15 transition hover:scale-105" style="background:@color.Value" data-task-color-swatch="@color.Value" title="@color.Name">
                            <span class="sr-only">@color.Name</span>
                        </button>
                    }
                </div>
            </div>
            <span asp-validation-for="Color"></span>
        </div>
        <div>
            <label asp-for="Icon" class="form-label">Ícone</label>
            <input asp-for="Icon" type="hidden" data-task-icon-input />
            <button type="button" class="btn-secondary w-full justify-between" data-task-icon-open>
                <span class="flex items-center gap-2">
                    <span class="grid h-8 w-8 place-items-center rounded-lg border border-white/10 bg-slate-950/60" data-task-icon-preview>
                        <i data-lucide="@selectedIcon.Value" class="h-4 w-4"></i>
                    </span>
                    <span data-task-icon-label>@selectedIcon.Name</span>
                </span>
                <i data-lucide="chevron-down" class="h-4 w-4"></i>
            </button>
            <p class="mt-2 text-xs text-slate-500" data-task-icon-help>Escolha visualmente o icone que melhor representa a tarefa.</p>
            <span asp-validation-for="Icon"></span>
        </div>
    </section>

    <div class="flex flex-wrap justify-end gap-2">
        <a class="btn-secondary" asp-action="Index">
            <i data-lucide="x" class="h-4 w-4"></i>
            Cancelar
        </a>
        <button class="btn-primary" type="submit">
            <i data-lucide="save" class="h-4 w-4"></i>
            @(isEdit ? "Salvar tarefa" : "Criar tarefa")
        </button>
    </div>

    <div class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4" data-task-icon-modal>
        <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-slate-950 p-5 shadow-2xl">
            <div class="mb-4 flex items-center justify-between gap-4">
                <div>
                    <h2 class="text-lg font-black text-white">Escolher ícone</h2>
                    <p class="mt-1 text-sm text-slate-400">Selecione um ícone para representar esta tarefa.</p>
                </div>
                <button type="button" class="btn-secondary px-3" data-task-icon-close aria-label="Fechar modal de ícones">
                    <i data-lucide="x" class="h-4 w-4"></i>
                </button>
            </div>
            <div class="grid gap-2 sm:grid-cols-3 md:grid-cols-5">
                @foreach (var icon in TaskVisualOptions.Icons)
                {
                    <button type="button"
                            class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-3 text-center text-sm font-semibold text-slate-200 transition hover:border-emerald-300/70 hover:bg-emerald-300/10"
                            data-task-icon-option="@icon.Value"
                            data-task-icon-name="@icon.Name">
                        <i data-lucide="@icon.Value" class="mx-auto mb-2 h-5 w-5"></i>
                        @icon.Name
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4" data-task-tags-modal>
        <div class="w-full max-w-3xl rounded-2xl border border-white/10 bg-slate-950 p-5 shadow-2xl">
            <div class="mb-4 flex items-center justify-between gap-4">
                <div>
                    <h2 class="text-lg font-black text-white">Gerenciar tags</h2>
                    <p class="mt-1 text-sm text-slate-400">Crie, edite cor e nome das tags do módulo de tarefas.</p>
                </div>
                <button type="button" class="btn-secondary px-3" data-task-tags-close aria-label="Fechar modal de tags">
                    <i data-lucide="x" class="h-4 w-4"></i>
                </button>
            </div>

            <div class="grid gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4 md:grid-cols-[1fr_auto_auto_auto] md:items-end">
                <input type="hidden" value="" data-task-tag-edit-id />
                <div>
                    <label class="form-label" for="TaskTagName">Nome da tag</label>
                    <input id="TaskTagName" class="form-input" maxlength="64" placeholder="Ex.: estudo" data-task-tag-name />
                </div>
                <div>
                    <label class="form-label" for="TaskTagColor">Cor</label>
                    <input id="TaskTagColor" type="color" class="h-11 w-16 rounded-xl border border-white/10 bg-slate-950 p-1" value="@TaskVisualOptions.DefaultColor" data-task-tag-color />
                </div>
                <button type="button" class="btn-secondary" data-task-tag-clear>Novo</button>
                <button type="button" class="btn-primary" data-task-tag-save>
                    <i data-lucide="save" class="h-4 w-4"></i>
                    Salvar
                </button>
            </div>
            <p class="mt-2 text-xs text-rose-300" data-task-tag-error></p>

            <div class="mt-4 max-h-72 space-y-2 overflow-auto pr-1" data-task-tag-manage-list>
                @foreach (var tag in Model.TagItems)
                {
                    <article class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2"
                             data-task-tag-row="@tag.Id"
                             data-task-tag-name="@tag.Name"
                             data-task-tag-color="@tag.Color">
                        <div class="min-w-0">
                            <div class="inline-flex items-center gap-2 text-sm font-semibold text-slate-200">
                                <span class="h-2.5 w-2.5 rounded-full" style="background:@tag.Color" data-task-tag-row-dot></span>
                                <span class="truncate" data-task-tag-row-name>@tag.Name</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" class="btn-secondary min-h-0 px-3 py-1 text-xs" data-task-tag-edit="@tag.Id">
                                <i data-lucide="pencil" class="h-3.5 w-3.5"></i>
                                Editar
                            </button>
                            <button type="button" class="btn-danger min-h-0 px-3 py-1 text-xs" data-task-tag-delete="@tag.Id">
                                <i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
                                Excluir
                            </button>
                        </div>
                    </article>
                }
            </div>
            <p class="mt-3 text-xs text-slate-500 @(Model.TagItems.Any() ? "hidden" : string.Empty)" data-task-tag-manage-empty>
                Sem tags ainda. Crie a primeira tag para organizar suas tarefas.
            </p>
        </div>
    </div>
</form>



