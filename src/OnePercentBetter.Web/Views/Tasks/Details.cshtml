@model TaskItemDetailsViewModel
@{
    ViewData["Title"] = "Detalhes da tarefa";
}

<div class="mx-auto max-w-5xl space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-violet-300">Tarefas</p>
            <h1 class="mt-1 text-3xl font-black text-white sm:text-4xl">Detalhes da ação</h1>
            <p class="mt-2 text-sm text-slate-400">Veja contexto, vínculos e histórico rápido antes de ajustar.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a class="btn-secondary" asp-action="Index">
                <i data-lucide="arrow-left" class="h-4 w-4"></i>
                Voltar
            </a>
            <a class="btn-primary" asp-action="Edit" asp-route-id="@Model.Task.Id">
                <i data-lucide="pencil" class="h-4 w-4"></i>
                Editar
            </a>
        </div>
    </div>

    <partial name="_TaskCard" model="Model.Task" />

    <section class="app-card p-5">
        <h2 class="text-lg font-black text-white">Anotações vinculadas</h2>
        @if (!Model.RelatedNotes.Any())
        {
            <p class="mt-3 text-sm text-slate-400">Nenhuma anotação vinculada a esta tarefa.</p>
        }
        else
        {
            <ul class="mt-3 space-y-2 text-sm text-slate-300">
                @foreach (var note in Model.RelatedNotes)
                {
                    <li class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2">@note</li>
                }
            </ul>
        }
    </section>
</div>
