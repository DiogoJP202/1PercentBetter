@model TaskItemCardViewModel
@{
    var statusClass = Model.Status switch
    {
        TaskItemStatus.Pending => "status-pill-warning",
        TaskItemStatus.InProgress => "status-pill-info",
        TaskItemStatus.Completed => "status-pill-success",
        TaskItemStatus.Cancelled => "status-pill-danger",
        TaskItemStatus.Postponed => "status-pill-neutral",
        _ => "status-pill-neutral"
    };

    var priorityClass = Model.Priority switch
    {
        TaskItemPriority.Urgent => "status-pill-danger",
        TaskItemPriority.High => "status-pill-warning",
        TaskItemPriority.Medium => "status-pill-info",
        TaskItemPriority.Low => "status-pill-neutral",
        _ => "status-pill-neutral"
    };

    var startTime = Model.StartTime;
    var hasTime = startTime.HasValue;
    var taskDateLabel = Model.TaskDate.HasValue ? Model.TaskDate.Value.ToString("dd/MM/yyyy") : "Sem data";
    var dueDateLabel = Model.DueDate.HasValue ? Model.DueDate.Value.ToString("dd/MM/yyyy") : "Sem prazo";
}

<article class="app-card p-5">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
            <div class="flex items-center gap-3">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl border border-white/10 bg-slate-950/50" style="color:@Model.Color">
                    <i data-lucide="@Model.Icon" class="h-5 w-5"></i>
                </span>
                <div class="min-w-0">
                    <h3 class="truncate text-lg font-black text-white">@Model.Title</h3>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="mt-1 truncate text-sm text-slate-400">@Model.Description</p>
                    }
                </div>
            </div>
        </div>

        <div class="flex flex-wrap gap-2">
            <span class="status-pill @statusClass">@Model.Status.ToDisplayName()</span>
            <span class="status-pill @priorityClass">@Model.Priority.ToDisplayName()</span>
            @if (Model.IsOverdue)
            {
                <span class="status-pill status-pill-danger">Atrasada</span>
            }
        </div>
    </div>

    <div class="mt-4 grid gap-3 md:grid-cols-4">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-3">
            <div class="text-xs text-slate-500">Data</div>
            <div class="mt-1 text-sm font-bold text-slate-200">@taskDateLabel</div>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-3">
            <div class="text-xs text-slate-500">Horário</div>
            <div class="mt-1 text-sm font-bold text-slate-200">
                @if (hasTime)
                {
                    @startTime!.Value.ToString(@"hh\:mm")
                    @if (Model.EndTime.HasValue)
                    {
                        <span> - @Model.EndTime.Value.ToString(@"hh\:mm")</span>
                    }
                }
                else
                {
                    <span>Sem horário</span>
                }
            </div>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-3">
            <div class="text-xs text-slate-500">Prazo</div>
            <div class="mt-1 text-sm font-bold @(Model.IsOverdue ? "text-rose-300" : "text-slate-200")">@dueDateLabel</div>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-3">
            <div class="text-xs text-slate-500">Calendário</div>
            <div class="mt-1 text-sm font-bold text-slate-200">@(Model.ShowOnCalendar ? "Visível" : "Oculta")</div>
        </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-400">
        @if (!string.IsNullOrWhiteSpace(Model.IdentityName))
        {
            <span class="status-pill status-pill-neutral"><i data-lucide="user-round-check"></i>@Model.IdentityName</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.GoalTitle))
        {
            <span class="status-pill status-pill-neutral"><i data-lucide="target"></i>@Model.GoalTitle</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.HabitTitle))
        {
            <span class="status-pill status-pill-neutral"><i data-lucide="repeat-2"></i>@Model.HabitTitle</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
        {
            <span class="status-pill status-pill-neutral"><i data-lucide="folder"></i>@Model.CategoryName</span>
        }
    </div>

    @if (Model.Tags.Any())
    {
        <div class="mt-3 flex flex-wrap gap-2">
            @foreach (var tag in Model.Tags)
            {
                <span class="status-pill status-pill-neutral" style="border-color:@tag.Color;color:@tag.Color">@tag.Name</span>
            }
        </div>
    }

    <div class="mt-5 flex flex-wrap justify-end gap-2">
        <a class="btn-secondary" asp-action="Details" asp-route-id="@Model.Id">
            <i data-lucide="eye" class="h-4 w-4"></i>
            Detalhes
        </a>
        <a class="btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">
            <i data-lucide="pencil" class="h-4 w-4"></i>
            Editar
        </a>

        @if (Model.Status == TaskItemStatus.Completed)
        {
            <form asp-action="Reopen"
                  asp-route-id="@Model.Id"
                  method="post">
                <button class="btn-secondary" type="submit">
                    <i data-lucide="rotate-ccw" class="h-4 w-4"></i>
                    Reabrir
                </button>
            </form>
        }
        else
        {
            <form asp-action="Complete"
                  asp-route-id="@Model.Id"
                  method="post">
                <button class="btn-primary" type="submit">
                    <i data-lucide="check" class="h-4 w-4"></i>
                    Concluir
                </button>
            </form>
            <form asp-action="Postpone"
                  asp-route-id="@Model.Id"
                  method="post">
                <button class="btn-secondary" type="submit">
                    <i data-lucide="calendar-plus" class="h-4 w-4"></i>
                    Adiar
                </button>
            </form>
            <form asp-action="Cancel"
                  asp-route-id="@Model.Id"
                  method="post"
                  data-confirm
                  data-confirm-title="Cancelar tarefa?"
                  data-confirm-text="A tarefa será marcada como cancelada."
                  data-confirm-button="Cancelar tarefa">
                <button class="btn-danger" type="submit">
                    <i data-lucide="x-circle" class="h-4 w-4"></i>
                    Cancelar
                </button>
            </form>
        }
    </div>
</article>
