@model TaskItemFormViewModel
@{
    ViewData["Title"] = "Editar tarefa";
}

<div class="mx-auto max-w-6xl space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-violet-300">Tarefas</p>
            <h1 class="mt-1 text-3xl font-black text-white sm:text-4xl">Editar ação pontual</h1>
            <p class="mt-2 max-w-2xl text-sm text-slate-400">
                Ajuste contexto, prioridade e data para manter o sistema executável.
            </p>
        </div>
        <a class="btn-secondary" asp-action="Index">
            <i data-lucide="arrow-left" class="h-4 w-4"></i>
            Voltar para tarefas
        </a>
    </div>

    <partial name="_Form" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/modules/tasks.js" asp-append-version="true"></script>
}
