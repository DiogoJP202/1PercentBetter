@model TaskItemListViewModel
@{
    ViewData["Title"] = "Tarefas";
    var filters = Model.Filters;
    var currentView = filters.View;

    IEnumerable<IGrouping<string, TaskItemCardViewModel>> groupedItems = [];
    if (currentView != "all")
    {
        groupedItems = filters.GroupBy switch
        {
            "goal" => Model.Items
                .OrderBy(item => string.IsNullOrWhiteSpace(item.GoalTitle) ? 1 : 0)
                .ThenBy(item => item.GoalTitle)
                .GroupBy(item => string.IsNullOrWhiteSpace(item.GoalTitle) ? "Sem objetivo vinculado" : item.GoalTitle!),
            "priority" => Model.Items
                .OrderByDescending(item => item.Priority)
                .ThenBy(item => item.TaskDate.HasValue ? 0 : 1)
                .ThenBy(item => item.TaskDate)
                .GroupBy(item => item.Priority.ToDisplayName()),
            _ => Model.Items
                .OrderBy(item => item.TaskDate.HasValue ? 0 : 1)
                .ThenBy(item => item.TaskDate)
                .ThenBy(item => item.StartTime.HasValue ? 0 : 1)
                .ThenBy(item => item.StartTime)
                .GroupBy(item => item.TaskDate.HasValue ? item.TaskDate.Value.ToString("dd/MM/yyyy") : "Sem data")
        };
    }
}

<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="text-sm font-semibold text-violet-300">Tarefas</p>
            <h1 class="mt-1 text-3xl font-black text-white sm:text-4xl">Ações pontuais do seu sistema</h1>
            <p class="mt-2 max-w-3xl text-sm text-slate-400">
                Tarefa é ação única com começo e fim. Se for recorrente, transforme em hábito.
            </p>
        </div>
        <a class="btn-primary" asp-action="Create">
            <i data-lucide="plus" class="h-4 w-4"></i>
            Nova tarefa
        </a>
    </div>

    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Ações de hoje</div>
            <div class="mt-3 text-4xl font-black text-violet-300">@Model.TodayCount</div>
            <p class="mt-2 text-xs text-slate-500">Pendentes para hoje.</p>
        </div>
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Pendentes</div>
            <div class="mt-3 text-4xl font-black text-sky-300">@Model.PendingCount</div>
            <p class="mt-2 text-xs text-slate-500">Não concluídas ou adiadas.</p>
        </div>
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Atrasadas</div>
            <div class="mt-3 text-4xl font-black @(Model.OverdueCount > 0 ? "text-rose-300" : "text-slate-200")">@Model.OverdueCount</div>
            <p class="mt-2 text-xs text-slate-500">Pedem ajuste imediato.</p>
        </div>
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Concluídas</div>
            <div class="mt-3 text-4xl font-black text-emerald-300">@Model.CompletedCount</div>
            <p class="mt-2 text-xs text-slate-500">Entregas finalizadas.</p>
        </div>
    </section>

    <section class="rounded-2xl border border-amber-300/20 bg-amber-300/10 p-4 text-sm text-amber-100">
        <strong>Tarefa != hábito.</strong>
        Tarefa é uma entrega única. Hábito é repetição para fortalecer identidade.
    </section>

    <section class="app-card p-5">
        <form method="get" class="grid gap-3 lg:grid-cols-7">
            <div class="lg:col-span-2">
                <label class="form-label" for="Search">Busca</label>
                <input class="form-input" id="Search" name="Search" value="@filters.Search" placeholder="Buscar por título, descrição ou tag" />
            </div>
            <div>
                <label class="form-label" for="View">Visão</label>
                <select class="form-select" id="View" name="View">
                    <option value="all" selected="@(currentView == "all")">Todas</option>
                    <option value="today" selected="@(currentView == "today")">Hoje</option>
                    <option value="week" selected="@(currentView == "week")">Esta semana</option>
                    <option value="overdue" selected="@(currentView == "overdue")">Atrasadas</option>
                    <option value="completed" selected="@(currentView == "completed")">Concluídas</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="Priority">Prioridade</label>
                <select class="form-select" id="Priority" name="Priority" asp-for="Filters.Priority" asp-items="@(EnumDisplayExtensions.ToSelectList<TaskItemPriority>())">
                    <option value="">Todas</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="TagId">Tag</label>
                <select class="form-select" id="TagId" name="TagId">
                    <option value="">Todas</option>
                    @foreach (var tag in filters.Tags)
                    {
                        <option value="@tag.Value" selected="@(filters.TagId?.ToString() == tag.Value)">@tag.Text</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" for="WithTime">Horário</label>
                <select class="form-select" id="WithTime" name="WithTime">
                    <option value="">Todos</option>
                    <option value="true" selected="@(filters.WithTime == true)">Com horário</option>
                    <option value="false" selected="@(filters.WithTime == false)">Sem horário</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="GoalId">Objetivo</label>
                <select class="form-select" id="GoalId" name="GoalId">
                    <option value="">Todos</option>
                    @foreach (var goal in filters.Goals)
                    {
                        <option value="@goal.Value" selected="@(filters.GoalId?.ToString() == goal.Value)">@goal.Text</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" for="IdentityId">Identidade</label>
                <select class="form-select" id="IdentityId" name="IdentityId">
                    <option value="">Todas</option>
                    @foreach (var identity in filters.Identities)
                    {
                        <option value="@identity.Value" selected="@(filters.IdentityId?.ToString() == identity.Value)">@identity.Text</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" for="CategoryId">Categoria</label>
                <select class="form-select" id="CategoryId" name="CategoryId">
                    <option value="">Todas</option>
                    @foreach (var category in filters.Categories)
                    {
                        <option value="@category.Value" selected="@(filters.CategoryId?.ToString() == category.Value)">@category.Text</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" for="GroupBy">Agrupar por</label>
                <select class="form-select" id="GroupBy" name="GroupBy">
                    <option value="date" selected="@(filters.GroupBy == "date")">Data</option>
                    <option value="goal" selected="@(filters.GroupBy == "goal")">Objetivo</option>
                    <option value="priority" selected="@(filters.GroupBy == "priority")">Prioridade</option>
                </select>
            </div>
            <div class="flex items-end gap-2 lg:col-span-2">
                <button class="btn-primary w-full" type="submit">
                    <i data-lucide="filter" class="h-4 w-4"></i>
                    Aplicar filtros
                </button>
                <a class="btn-secondary" asp-action="Index">Limpar</a>
            </div>
        </form>
    </section>

    @if (!Model.Items.Any())
    {
        <section class="app-card p-8 text-center">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-violet-300/20 bg-violet-300/10 text-violet-300">
                <i data-lucide="list-checks" class="h-7 w-7"></i>
            </div>
            <h2 class="mt-5 text-2xl font-black text-white">Nenhuma tarefa encontrada.</h2>
            <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-400">
                Ajuste filtros ou cadastre sua primeira ação pontual para mover um objetivo.
            </p>
            <a class="btn-primary mt-5" asp-action="Create">
                <i data-lucide="plus" class="h-4 w-4"></i>
                Criar tarefa
            </a>
        </section>
    }
    else if (currentView == "all")
    {
        <div class="space-y-6">
            @if (Model.OverdueItems.Any())
            {
                <section class="space-y-3">
                    <h2 class="text-lg font-black text-rose-200">Atrasadas</h2>
                    @foreach (var item in Model.OverdueItems)
                    {
                        <partial name="_TaskCard" model="item" />
                    }
                </section>
            }

            @if (Model.TodayItems.Any())
            {
                <section class="space-y-3">
                    <h2 class="text-lg font-black text-violet-200">Hoje</h2>
                    @foreach (var item in Model.TodayItems)
                    {
                        <partial name="_TaskCard" model="item" />
                    }
                </section>
            }

            @if (Model.FutureItems.Any())
            {
                <section class="space-y-3">
                    <h2 class="text-lg font-black text-sky-200">Futuras</h2>
                    @foreach (var item in Model.FutureItems)
                    {
                        <partial name="_TaskCard" model="item" />
                    }
                </section>
            }

            @if (Model.CompletedItems.Any())
            {
                <section class="space-y-3">
                    <h2 class="text-lg font-black text-emerald-200">Concluídas</h2>
                    @foreach (var item in Model.CompletedItems.Take(12))
                    {
                        <partial name="_TaskCard" model="item" />
                    }
                </section>
            }
        </div>
    }
    else
    {
        <section class="space-y-5">
            @foreach (var group in groupedItems)
            {
                <div class="space-y-3">
                    <h2 class="text-lg font-black text-white">
                        @group.Key
                        <span class="text-sm font-semibold text-slate-500">(@group.Count())</span>
                    </h2>
                    @foreach (var item in group)
                    {
                        <partial name="_TaskCard" model="item" />
                    }
                </div>
            }
        </section>
    }
</div>
