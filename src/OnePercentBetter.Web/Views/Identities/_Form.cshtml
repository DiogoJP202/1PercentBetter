@model IdentityFormViewModel

<form class="app-card space-y-5 p-6" method="post">
    <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3"></div>

    <div>
        <label asp-for="Name" class="form-label">Nome</label>
        <input asp-for="Name" class="form-input" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="IdentityStatement" class="form-label">Frase da identidade</label>
        <input asp-for="IdentityStatement" class="form-input" />
        <span asp-validation-for="IdentityStatement"></span>
    </div>

    <div>
        <label asp-for="Description" class="form-label">Descricao</label>
        <textarea asp-for="Description" class="form-textarea"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
        <div>
            <label asp-for="CategoryId" class="form-label">Categoria</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">Sem categoria</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value">@category.Text</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" asp-items="@(EnumDisplayExtensions.ToSelectList<ItemStatus>())" class="form-select"></select>
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
        <div>
            <label asp-for="Color" class="form-label">Cor</label>
            <input asp-for="Color" class="form-input" />
        </div>
        <div>
            <label asp-for="Icon" class="form-label">Icone Lucide</label>
            <input asp-for="Icon" class="form-input" />
        </div>
    </div>

    <div class="flex flex-wrap justify-end gap-2">
        <a class="btn-secondary" asp-action="Index">Cancelar</a>
        <button class="btn-primary" type="submit">Salvar</button>
    </div>
</form>
