@model IReadOnlyList<IdentityListItemViewModel>
@{
    ViewData["Title"] = "Identidades";
    var activeCount = Model.Count(item => item.Status == ItemStatus.Active);
    var totalHabits = Model.Sum(item => item.HabitsCount);
    var totalGoals = Model.Sum(item => item.GoalsCount);
}

<div class="space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="text-sm font-semibold text-emerald-300">Identidades</p>
            <h1 class="mt-1 text-3xl font-black text-white sm:text-4xl">Quem você está se tornando</h1>
            <p class="mt-2 max-w-2xl text-sm text-slate-400">Identidades dão direção aos seus hábitos: elas descrevem a pessoa que pratica os comportamentos que você quer construir.</p>
        </div>
        <a class="btn-primary" asp-action="Create">
            <i data-lucide="plus" class="h-4 w-4"></i>
            Nova identidade
        </a>
    </div>

    <section class="grid gap-4 sm:grid-cols-3">
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Identidades ativas</div>
            <div class="mt-3 text-4xl font-black text-emerald-300">@activeCount</div>
            <p class="mt-2 text-xs text-slate-500">Versões de você em construção.</p>
        </div>
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Hábitos vinculados</div>
            <div class="mt-3 text-4xl font-black text-sky-300">@totalHabits</div>
            <p class="mt-2 text-xs text-slate-500">Ações que sustentam suas identidades.</p>
        </div>
        <div class="app-card p-5">
            <div class="text-sm text-slate-400">Objetivos vinculados</div>
            <div class="mt-3 text-4xl font-black text-white">@totalGoals</div>
            <p class="mt-2 text-xs text-slate-500">Resultados conectados ao seu sistema.</p>
        </div>
    </section>

    @if (!Model.Any())
    {
        <section class="app-card p-8 text-center">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-emerald-300/20 bg-emerald-300/10 text-emerald-300">
                <i data-lucide="user-round-check" class="h-7 w-7"></i>
            </div>
            <h2 class="mt-5 text-2xl font-black text-white">Você ainda não criou nenhuma identidade.</h2>
            <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-400">Comece definindo quem você quer se tornar. Depois conecte objetivos e hábitos a essa versão de você.</p>
            <a class="btn-primary mt-5" asp-action="Create">
                <i data-lucide="plus" class="h-4 w-4"></i>
                Criar primeira identidade
            </a>
        </section>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-2">
            @foreach (var item in Model)
            {
                var statusClass = item.Status switch
                {
                    ItemStatus.Active => "status-pill-success",
                    ItemStatus.Paused => "status-pill-warning",
                    ItemStatus.Completed => "status-pill-info",
                    ItemStatus.Canceled => "status-pill-danger",
                    _ => "status-pill-neutral"
                };

                <article class="app-card p-5">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <div class="flex items-center gap-3">
                                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl border border-white/10 bg-slate-950/50" style="color:@item.Color">
                                    <i data-lucide="@item.Icon" class="h-6 w-6"></i>
                                </span>
                                <div class="min-w-0">
                                    <h2 class="truncate text-xl font-black text-white">@item.Name</h2>
                                    <p class="mt-1 text-sm text-slate-400">@(string.IsNullOrWhiteSpace(item.CategoryName) ? "Sem categoria" : item.CategoryName)</p>
                                </div>
                            </div>
                        </div>
                        <span class="status-pill @statusClass">@item.Status.ToDisplayName()</span>
                    </div>

                    <div class="mt-5 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                        <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">Frase da identidade</div>
                        <p class="mt-2 text-sm leading-6 text-slate-200">@item.IdentityStatement</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <p class="mt-4 text-sm leading-6 text-slate-400">@item.Description</p>
                    }

                    <div class="mt-5 flex flex-wrap gap-2">
                        <span class="status-pill status-pill-neutral">
                            <i data-lucide="repeat-2"></i>
                            @item.HabitsCount hábito(s)
                        </span>
                        <span class="status-pill status-pill-neutral">
                            <i data-lucide="target"></i>
                            @item.GoalsCount objetivo(s)
                        </span>
                    </div>

                    <div class="mt-5 flex flex-wrap items-center justify-end gap-2">
                        <a class="btn-secondary" asp-action="Edit" asp-route-id="@item.Id">
                            <i data-lucide="pencil" class="h-4 w-4"></i>
                            Editar
                        </a>
                        <form asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post"
                              data-confirm
                              data-confirm-tone="danger"
                              data-confirm-title="Excluir identidade?"
                              data-confirm-text="Objetivos, hábitos e anotações vinculados serão mantidos, mas ficarão sem esta identidade."
                              data-confirm-button="Excluir">
                            <button class="btn-danger" type="submit">
                                <i data-lucide="trash-2" class="h-4 w-4"></i>
                                Excluir
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</div>
