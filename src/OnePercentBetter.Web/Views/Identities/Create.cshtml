@model IdentityFormViewModel
@{
    ViewData["Title"] = "Nova identidade";
}

<div class="mx-auto max-w-4xl space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-emerald-300">Nova identidade</p>
            <h1 class="mt-1 text-3xl font-black text-white">Defina quem você quer se tornar</h1>
            <p class="mt-2 max-w-2xl text-sm text-slate-400">Pense em uma versão de você que já pratica os comportamentos que deseja construir.</p>
        </div>
        <a class="btn-secondary" asp-action="Index">
            <i data-lucide="arrow-left" class="h-4 w-4"></i>
            Voltar
        </a>
    </div>

    <partial name="_Form" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/modules/identities-form.js" asp-append-version="true"></script>
}
