@model DailyCheckInViewModel
@{
    ViewData["Title"] = "Check-in";
    var isToday = Model.Date.Date == AppClock.Today;
    var moodOptions = new[]
    {
        new { Value = MoodLevel.VeryBad, Face = "ðŸ˜ž", Label = "Muito ruim", Hint = "Dia pesado" },
        new { Value = MoodLevel.Bad, Face = "ðŸ™", Label = "Ruim", Hint = "Abaixo do normal" },
        new { Value = MoodLevel.Neutral, Face = "ðŸ˜", Label = "Neutro", Hint = "Dia estÃ¡vel" },
        new { Value = MoodLevel.Good, Face = "ðŸ™‚", Label = "Bom", Hint = "Boa energia" },
        new { Value = MoodLevel.VeryGood, Face = "ðŸ˜„", Label = "Muito bom", Hint = "Dia excelente" }
    };
}

<div class="mx-auto max-w-4xl space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-emerald-300">Check-in diÃ¡rio</p>
            <h1 class="mt-1 text-3xl font-black text-white">@(isToday ? "Como foi seu dia?" : $"Check-in de {Model.Date:dd/MM/yyyy}")</h1>
            <p class="mt-2 text-sm text-slate-400">Registre uma leitura honesta do dia. Pequeno hoje, forte no acumulado.</p>
        </div>
        <a class="btn-secondary" asp-action="Index" asp-route-period="month" asp-route-year="@Model.Date.Year" asp-route-month="@Model.Date.Month">
            <i data-lucide="arrow-left" class="h-4 w-4"></i>
            Voltar para evoluÃ§Ã£o
        </a>
    </div>

    <form class="app-card space-y-6 p-6" asp-action="Edit" method="post" autocomplete="off" data-checkin-form>
        <div asp-validation-summary="ModelOnly" class="rounded-xl border border-rose-400/30 bg-rose-500/10 p-3"></div>

        <div>
            <label asp-for="Date" class="form-label">Data</label>
            <input asp-for="Date" class="form-input" />
        </div>

        <section class="grid gap-3 md:grid-cols-4">
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <div class="text-xs text-slate-500">Tarefas planejadas</div>
                <div class="mt-1 text-2xl font-black text-white">@Model.PlannedTasks</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <div class="text-xs text-slate-500">Concluidas</div>
                <div class="mt-1 text-2xl font-black text-emerald-300">@Model.CompletedTasks</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <div class="text-xs text-slate-500">Adiadas</div>
                <div class="mt-1 text-2xl font-black text-amber-300">@Model.PostponedTasks</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <div class="text-xs text-slate-500">Pendentes</div>
                <div class="mt-1 text-2xl font-black text-rose-300">@Model.PendingTasks</div>
            </div>
        </section>

        <div>
            <label asp-for="Mood" class="form-label">Humor</label>
            <div class="grid gap-3 sm:grid-cols-5">
                @foreach (var mood in moodOptions)
                {
                    var inputId = $"Mood_{mood.Value}";
                    <label for="@inputId" class="group cursor-pointer">
                        <input id="@inputId"
                               asp-for="Mood"
                               type="radio"
                               value="@((int)mood.Value)"
                               class="peer sr-only" />
                        <span class="flex min-h-28 flex-col items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] p-3 text-center transition hover:border-emerald-300/50 hover:bg-emerald-300/10 peer-checked:border-emerald-300 peer-checked:bg-emerald-300/15 peer-checked:shadow-[0_0_0_1px_rgba(110,231,183,0.35)]">
                            <span class="text-3xl leading-none" aria-hidden="true">@mood.Face</span>
                            <span class="mt-3 text-sm font-bold text-white">@mood.Label</span>
                            <span class="mt-1 text-xs text-slate-500 group-hover:text-slate-300">@mood.Hint</span>
                        </span>
                    </label>
                }
            </div>
            <p class="mt-2 text-xs text-slate-500">Escolha a carinha que melhor representa como vocÃª se sentiu hoje.</p>
            <span asp-validation-for="Mood"></span>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <label asp-for="DayScore" class="form-label">Nota do dia</label>
                <input asp-for="DayScore" type="range" class="w-full accent-emerald-400" min="1" max="5" data-checkin-score />
                <div class="mt-2 text-2xl font-black text-white" data-checkin-score-output>@Model.DayScore</div>
                <span asp-validation-for="DayScore"></span>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <label asp-for="EnergyLevel" class="form-label">Energia</label>
                <input asp-for="EnergyLevel" type="range" class="w-full accent-emerald-400" min="1" max="5" data-checkin-score />
                <div class="mt-2 text-2xl font-black text-white" data-checkin-score-output>@Model.EnergyLevel</div>
                <span asp-validation-for="EnergyLevel"></span>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <label asp-for="ProductivityLevel" class="form-label">Produtividade</label>
                <input asp-for="ProductivityLevel" type="range" class="w-full accent-emerald-400" min="1" max="5" data-checkin-score />
                <div class="mt-2 text-2xl font-black text-white" data-checkin-score-output>@Model.ProductivityLevel</div>
                <span asp-validation-for="ProductivityLevel"></span>
            </div>
        </div>

        <div class="rounded-2xl border border-emerald-300/20 bg-emerald-300/10 p-4">
            <div class="text-sm font-semibold text-emerald-100">Nota total do check-in</div>
            <div class="mt-1 text-4xl font-black text-white" data-checkin-total>@(Model.DayScore + Model.EnergyLevel + Model.ProductivityLevel)</div>
            <p class="mt-1 text-xs text-emerald-100/80">Soma de nota do dia, energia e produtividade. MÃ¡ximo: 15.</p>
        </div>

        <div>
            <label asp-for="SmallWin" class="form-label">Pequena vitÃ³ria</label>
            <input asp-for="SmallWin" class="form-input" placeholder="Consegui estudar por 20 minutos" />
            <span asp-validation-for="SmallWin"></span>
        </div>

        <div>
            <label asp-for="MainDifficulty" class="form-label">Principal dificuldade</label>
            <input asp-for="MainDifficulty" class="form-input" placeholder="Tive dificuldade para manter o foco" />
            <span asp-validation-for="MainDifficulty"></span>
        </div>

        <div>
            <label asp-for="TaskBlocker" class="form-label">Alguma tarefa importante ficou travada hoje?</label>
            <input asp-for="TaskBlocker" class="form-input" placeholder="Ex.: Fiquei bloqueado na modelagem da migration." />
            <span asp-validation-for="TaskBlocker"></span>
        </div>

        <div>
            <label asp-for="TomorrowAdjustment" class="form-label">Ajuste para amanhÃ£</label>
            <input asp-for="TomorrowAdjustment" class="form-input" placeholder="ComeÃ§ar pelo hÃ¡bito mais fÃ¡cil" />
            <span asp-validation-for="TomorrowAdjustment"></span>
        </div>

        <div>
            <label asp-for="Notes" class="form-label">Notas</label>
            <textarea asp-for="Notes" class="form-textarea" placeholder="Escreva observaÃ§Ãµes livres sobre seu dia"></textarea>
            <span asp-validation-for="Notes"></span>
        </div>

        <div class="flex flex-wrap justify-end gap-2">
            <a class="btn-secondary" asp-action="Index" asp-route-period="month" asp-route-year="@Model.Date.Year" asp-route-month="@Model.Date.Month">Cancelar</a>
            <button class="btn-primary" type="submit">
                <i data-lucide="save" class="h-4 w-4"></i>
                Salvar check-in
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/modules/checkins-form.js" asp-append-version="true"></script>
}

