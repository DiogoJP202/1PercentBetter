@model GoalFormViewModel
@{
    ViewData["Title"] = "Novo objetivo";
}

<div class="mx-auto max-w-4xl space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-sky-300">Novo objetivo</p>
            <h1 class="mt-1 text-3xl font-black text-white">Escolha uma direção clara</h1>
            <p class="mt-2 max-w-2xl text-sm text-slate-400">Um bom objetivo mostra onde você quer chegar e facilita escolher quais hábitos sustentam esse caminho.</p>
        </div>
        <a class="btn-secondary" asp-action="Index">
            <i data-lucide="arrow-left" class="h-4 w-4"></i>
            Voltar
        </a>
    </div>

    <partial name="_Form" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/modules/goals-form.js" asp-append-version="true"></script>
}
